# =============================================================
# EditorConfig 配置文件
# 文档: https://editorconfig.org
#
# 作用：统一不同编辑器/IDE 之间的基础文件格式
# 优先级：EditorConfig < Prettier < ESLint
# 即：EditorConfig 管最底层的物理格式，Prettier 和 ESLint 在其之上工作
# =============================================================

# root = true 表示这是项目的根配置文件
# 编辑器会从这里开始向上查找 .editorconfig，找到 root=true 后停止
# 避免被父级目录（比如整个 Documents 目录）的配置干扰
root = true

# -------------------------------------------------------------
# [*] 表示以下规则适用于所有文件类型
# -------------------------------------------------------------
[*]

# 文件编码统一为 UTF-8，避免中文/特殊字符乱码
charset = utf-8

# 换行符统一使用 LF（\n，Unix 风格）
# Windows 默认是 CRLF（\r\n），统一成 LF 避免 git diff 时整行标红
end_of_line = lf

# 文件末尾必须有一个空行
# 符合 POSIX 规范，也让 git diff 更干净
insert_final_newline = true

# 缩进使用空格（而不是 tab）
indent_style = space

# 缩进宽度为 2 个空格
# 与 Prettier 配置中的 tabWidth: 2 保持一致
indent_size = 2

# 自动去掉行尾多余的空格
# 保持代码干净，避免无意义的 git diff
trim_trailing_whitespace = true

# -------------------------------------------------------------
# [*.md] 表示以下规则只对 Markdown 文件生效（覆盖上面的通用规则）
# -------------------------------------------------------------
[*.md]

# Markdown 中行尾的两个空格是"强制换行"语法，是有意义的
# 所以这里关闭"去行尾空格"，避免误删
trim_trailing_whitespace = false

# -------------------------------------------------------------
# [*.{yml,yaml}] 只对 YAML 文件生效
# -------------------------------------------------------------
[*.{yml,yaml}]

# YAML 也统一用 2 空格缩进（虽然和通用规则相同，但显式声明更清晰）
indent_size = 2

# -------------------------------------------------------------
# [Makefile] 只对 Makefile 生效
# -------------------------------------------------------------
[Makefile]

# Makefile 语法强制要求使用 tab 缩进，不能用空格
# 这是一个典型的"例外覆盖"，说明 EditorConfig 支持按文件类型定制
indent_style = tab